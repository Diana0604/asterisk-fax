[
  {
    "stepName": "wait_press",
    "buttonPress": "True"
  },
  {
    "stepName": "hello",
    "call": {
      "call": "00_hello.call",
      "wait": 3
    },
    "diegeticSounds": [
      {
        "sound": "/fax/sounds/speaker/00.1_please_answer_phone.wav",
        "wait": 3,
        "nextSoundIf": {
          "key": "show",
          "values": ["started"]
        },
        "stopAfter": 8,
        "loop": true
      }
    ],
    "nextStepWhen": {
      "key": "name",
      "values": ["finished"]
    }
  },
  {
    "stepName": "calculating",
    "diegeticSounds": [
      {
        "sound": "/fax/sounds/speaker/08_loading.wav",
        "wait": 4
      }
    ]
  },

  {
    "stepName": "idle",
    "nextStepWhen": {
      "key": "send_feed",
      "values": ["True"]
    }
  },
  {
    "stepName": "feed",
    "call": {
      "call": "infinite_scroll.call",
      "wait": 0
    },
    "nextStepWhen": {
      "key": "post",
      "values": ["received"]
    },
    "wait": 10
  },
  {
    "stepName": "well_done",
    "diegeticSounds": [],
    "call": {
      "call" :  "credits.call"
    }
  }
]
