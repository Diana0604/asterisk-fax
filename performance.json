[
  {
    "stepName": "hello",
    "call": {
      "call": "00_hello.call",
      "wait": 3
    },
    "diegeticSounds": [
      {
        "sound": "/fax/sounds/speaker/00.1_please_answer_phone.wav",
        "wait": 3,
        "nextSoundIf": {
          "key": "show",
          "values": ["started"]
        },
        "stopAfter": 8,
        "loop": true
      }
    ],
    "nextStepWhen": {
      "key": "name",
      "values": ["finished"]
    }
  },
