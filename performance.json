          "key": "answer",
          "values": ["4", "5", "6"]
        }
      },
      {
        "sound": "/fax/sounds/speaker/05.a1-7-9.2.wav",
        "playIf": {
          "key": "answer",
          "values": ["7", "8", "9"]
        }
      }
